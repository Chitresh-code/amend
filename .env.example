# Copy to .env and fill in real values. Never commit .env.

# --- PostgreSQL / pgvector ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=amend
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=
NEO4J_PASSWORD=

# --- Redis (rate limiting) ---
REDIS_URL=redis://redis:6379/0

# --- Model providers, query path ---
# Comma-separated allowlist of chat-model providers this deployment can integrate with
# at all. This does not grant access to any specific user; it only controls which
# provider SDKs/extras are permitted. There is no server-side default model: a request
# that omits `model` is rejected with an explicit error.
ENABLED_MODEL_PROVIDERS=anthropic,openai,gemini,ollama

# Master key used to encrypt/decrypt user-supplied provider API keys at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotate by re-encrypting stored credentials; do not lose the previous key before rotation.
CREDENTIAL_ENCRYPTION_KEY=

# --- Amend API-key auth ---
# Amend issues its own API keys to callers so that stored model credentials, rate
# limits, and query telemetry can be scoped per caller. Hash pepper used when hashing
# issued API keys before storage. Generate the same way as CREDENTIAL_ENCRYPTION_KEY.
API_KEY_HASH_PEPPER=

# --- Web app account sessions ---
# Pepper used when hashing session tokens (user_sessions.token_hash) before storage.
# Generate the same way as CREDENTIAL_ENCRYPTION_KEY. Rotating this invalidates every
# active session (forces re-login), unlike CREDENTIAL_ENCRYPTION_KEY which must be
# rotated by re-encrypting, not just replaced.
SESSION_TOKEN_PEPPER=

# --- Ingestion worker embedding model (deployment-owned) ---
# The corpus is embedded once, offline, by the ingestion worker, not per end user.
# These credentials belong to the deployment, not to any individual caller.
INGESTION_EMBEDDING_PROVIDER=
INGESTION_EMBEDDING_MODEL_ID=
INGESTION_EMBEDDING_API_KEY=

# --- Rate limiting ---
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=20

# --- Query telemetry retention ---
TELEMETRY_RETENTION_DAYS=7

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
