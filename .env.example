# Copy to .env and fill in real values. Never commit .env.
# See docs/ARCHITECTURE.md, docs/DATA_MODEL.md, and docs/PRD.md (§45, §52, §70) for the
# requirements behind these variables.

# --- PostgreSQL / pgvector ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=amend
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=
NEO4J_PASSWORD=

# --- Redis (rate limiting; PRD §45) ---
REDIS_URL=redis://redis:6379/0

# --- Model providers, query path (PRD §70) ---
# Comma-separated allowlist of chat-model providers this deployment can integrate with
# at all. This does not grant access to any specific user; it only controls which
# provider SDKs/extras are permitted. There is no server-side default model: a request
# that omits `model` is rejected with an explicit error (see PRD §70.1).
ENABLED_MODEL_PROVIDERS=anthropic,openai,gemini,ollama

# Master key used to encrypt/decrypt user-supplied provider API keys at rest
# (see docs/DATA_MODEL.md, model_credentials table). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotate by re-encrypting stored credentials; do not lose the previous key before rotation.
CREDENTIAL_ENCRYPTION_KEY=

# Provider API keys are NOT configured here. Each caller submits their own credentials
# through POST /v1/credentials (authenticated with their Amend API key), and Amend
# stores them encrypted with CREDENTIAL_ENCRYPTION_KEY. See PRD §70.2.

# --- Amend API-key auth ---
# Amend issues its own API keys to callers so that stored model credentials, rate
# limits, and query telemetry can be scoped per caller (PRD §45, §70.1). Hash pepper
# used when hashing issued API keys before storage (see docs/DATA_MODEL.md, api_keys
# table). Generate the same way as CREDENTIAL_ENCRYPTION_KEY.
API_KEY_HASH_PEPPER=

# --- Ingestion worker embedding model (deployment-owned, PRD §70.4) ---
# The corpus is embedded once, offline, by the ingestion worker, not per end user.
# These credentials belong to the deployment, not to any individual caller.
INGESTION_EMBEDDING_PROVIDER=
INGESTION_EMBEDDING_MODEL_ID=
INGESTION_EMBEDDING_API_KEY=

# --- Rate limiting (PRD §45) ---
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=20

# --- Query telemetry retention (PRD §47, §52) ---
TELEMETRY_RETENTION_DAYS=7

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
